---
import Analytics from '@vercel/analytics/astro';

interface Props {
	lang?: 'fi' | 'en';
}

const { lang = 'fi' } = Astro.props;
const siteUrl = 'https://kopepix.vercel.app';
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@900&family=Plus+Jakarta+Sans:wght@400..800&family=Saira+Stencil+One&display=swap"
			rel="stylesheet"
		/>
		<link rel="alternate" hreflang="fi" href={`${siteUrl}/`} />
		<link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
		<title>Konsta Kivioja — Portfolio</title>
	</head>
	<body>
		<slot />
		<Analytics />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
